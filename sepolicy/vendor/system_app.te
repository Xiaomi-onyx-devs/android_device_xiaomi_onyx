# Audio
allow system_app audio_socket:sock_file rw_file_perms;
allow system_app hal_audio_default:unix_stream_socket connectto;
get_prop(system_app, vendor_audio_cloud_ctrl_mi_prop);
r_dir_file(system_app, vendor_persist_audio_file);

# Thermal
allow system_app sysfs_thermal:file write;
allow system_app sysfs_thermal:file rw_file_perms;

# Fastcharge
allow system_app sysfs_fastcharge:file rw_file_perms;

# Battery
allow system_app vendor_sysfs_battery_supply:dir { search };
allow system_app vendor_sysfs_battery_supply:file rw_file_perms;
